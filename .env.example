# Copy this file to .env.local and fill in your own values.
# Use the direct (non-SRV) connection string from Atlas → Connect → Drivers
# (switch the driver version to an older one to reveal the mongodb:// form)
# if your network blocks the SRV DNS lookup used by mongodb+srv://.
MONGODB_URI=mongodb://<user>:<password>@<shard-00>:27017,<shard-01>:27017,<shard-02>:27017/?ssl=true&authSource=admin&retryWrites=true&w=majority&appName=Cluster0
